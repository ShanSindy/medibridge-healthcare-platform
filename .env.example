# MediBridge backend configuration for local development.
# Copy to .env (git-ignored) and replace every placeholder. Placeholders only:
# never commit real credentials. Variables already set in the shell take
# precedence over values in .env.
#
# The test suite does not use this file; it reads .env.test instead
# (see .env.test.example and docs/development-and-testing.md).

# --- PostgreSQL (all required) ---------------------------------------------
# Use a dedicated application role that owns DB_NAME, not a superuser.
# docs/getting-started.md shows how an administrator creates both.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medibridge_dev
DB_USER=medibridge_app
DB_PASSWORD=replace-with-the-medibridge_app-password

# --- Authentication -----------------------------------------------------------
# Required. HS256 signing key for access tokens: at least 48 characters, random.
# The placeholder below is deliberately too short, so the application refuses to
# start until it is replaced. Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE-ME-generate-a-random-key

# Optional. Access-token lifetime in minutes (default 30).
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
