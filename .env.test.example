# Test-suite configuration. Copy to .env.test (git-ignored) and fill in.
# Placeholder values only - never commit real credentials.
#
# pytest creates its own disposable database (medibridge_test_<random>) on
# this server for every run and drops it afterwards. It ignores DB_NAME and
# never touches existing databases. Run pytest from the repository root.
#
# When this file exists, it is the only source of the settings below: any
# setting omitted here is removed from the environment for the test run, so
# shell or development values are never used.

# Required: confirms this configuration is meant for tests.
MEDIBRIDGE_ENV=test

# Recommended: a dedicated role with LOGIN and CREATEDB only (not a superuser).
# An administrator creates it once, for example:
#   psql -U postgres -d postgres
#   CREATE ROLE medibridge_tester LOGIN CREATEDB NOSUPERUSER NOCREATEROLE NOREPLICATION;
#   \password medibridge_tester
# The role needs no privileges on any existing database.
DB_HOST=localhost
DB_PORT=5432
DB_USER=medibridge_tester
DB_PASSWORD=change-me

# Signing key for test tokens only (at least 48 characters).
JWT_SECRET_KEY=replace-with-a-random-test-only-secret-of-48-or-more-characters
# Optional; if omitted the application default (30 minutes) applies.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional:
# TEST_DB_ALLOWED_HOSTS=localhost,127.0.0.1,::1   # default; DB_HOST must be listed
# TEST_DB_MAINTENANCE_DB=postgres                 # database used to CREATE/DROP
#
# Not recommended. Accepted ONLY from this file (never from the shell or CI):
# lets the suite run as a PostgreSQL superuser, with a warning before any
# database is created.
# TEST_DB_ALLOW_SUPERUSER=1
