# Test-suite configuration. Copy to .env.test (git-ignored) and fill in.
# Placeholder values only — never commit real credentials.
#
# pytest creates its own disposable database (medibridge_test_<random>) on
# this server for every run and drops it afterwards. It never uses DB_NAME
# and never touches existing databases.

# Required: confirms this configuration is meant for tests.
MEDIBRIDGE_ENV=test

# Use a dedicated role with LOGIN and CREATEDB only (not a superuser).
# See "Running the backend tests" in the pull request / README for setup.
DB_HOST=localhost
DB_PORT=5432
DB_USER=medibridge_tester
DB_PASSWORD=change-me

# Signing key for test tokens only (at least 48 characters).
JWT_SECRET_KEY=replace-with-a-random-test-only-secret-of-48-or-more-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional:
# TEST_DB_ALLOWED_HOSTS=localhost,127.0.0.1,::1   # default; DB_HOST must be listed
# TEST_DB_MAINTENANCE_DB=postgres                 # database used to CREATE/DROP
# TEST_DB_ALLOW_SUPERUSER=1                       # only if you accept the risk
