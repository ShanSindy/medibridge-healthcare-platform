# MediBridge dashboard configuration. Copy to .env.local (git-ignored) and adjust.
# Never put tokens, passwords or other secrets in VITE_* variables: they are bundled into the browser app.

# Patients page data source: "demo" (default, synthetic data) or "api" (FastAPI backend, sign-in required).
VITE_DATA_SOURCE=demo

# FastAPI base URL. Defaults to http://localhost:8000.
# The backend has no CORS configuration, so for local development use /api
# to route requests through the Vite dev/preview proxy (same origin).
VITE_API_BASE_URL=http://localhost:8000

# Where the Vite /api proxy forwards requests (dev server and `vite preview` only; not exposed to the browser).
API_PROXY_TARGET=http://localhost:8000
